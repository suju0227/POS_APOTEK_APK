model IdempotencyKey {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key              String    @db.VarChar(150)
  userId           String    @map("user_id") @db.Uuid
  actionType       String    @map("action_type") @db.VarChar(80)
  requestHash      String    @map("request_hash") @db.Text
  responseSnapshot Json?     @map("response_snapshot")
  status           String    @db.VarChar(30)
  expiresAt        DateTime  @map("expires_at") @db.Timestamp(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id])

  @@index([userId], map: "idx_idempotency_keys_user_id")
  @@index([actionType], map: "idx_idempotency_keys_action_type")
  @@index([expiresAt], map: "idx_idempotency_keys_expires_at")
  @@map("idempotency_keys")
}

model Prescription {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pharmacistId       String    @map("pharmacist_id") @db.Uuid
  prescriptionNumber String    @unique @map("prescription_number") @db.VarChar(100)
  patientName        String    @map("patient_name") @db.VarChar(150)
  patientPhone       String?   @map("patient_phone") @db.VarChar(50)
  doctorName         String?   @map("doctor_name") @db.VarChar(150)
  prescriptionDate   DateTime  @map("prescription_date") @db.Date
  status             String    @default("DRAFT") @db.VarChar(50)
  note               String?   @db.Text
  readyAt            DateTime? @map("ready_at") @db.Timestamp(6)
  paidAt             DateTime? @map("paid_at") @db.Timestamp(6)
  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamp(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamp(6)

  pharmacist        User               @relation("PrescriptionPharmacist", fields: [pharmacistId], references: [id])
  items             PrescriptionItem[]
  sale              Sale?
  counselingRecords CounselingRecord[]

  @@index([pharmacistId], map: "idx_prescriptions_pharmacist_id")
  @@index([status], map: "idx_prescriptions_status")
  @@index([prescriptionDate], map: "idx_prescriptions_prescription_date")
  @@map("prescriptions")
}

model PrescriptionItem {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  prescriptionId String   @map("prescription_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  productUnitId  String   @map("product_unit_id") @db.Uuid
  qtySaleUnit    Decimal  @map("qty_sale_unit") @db.Decimal(18, 4)
  instruction    String?  @db.Text
  note           String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  prescription Prescription @relation(fields: [prescriptionId], references: [id])
  product      Product      @relation(fields: [productId], references: [id])
  productUnit  ProductUnit  @relation(fields: [productUnitId], references: [id])

  @@index([prescriptionId], map: "idx_prescription_items_prescription_id")
  @@index([productId], map: "idx_prescription_items_product_id")
  @@index([productUnitId], map: "idx_prescription_items_product_unit_id")
  @@map("prescription_items")
}

model CounselingRecord {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pharmacistId     String    @map("pharmacist_id") @db.Uuid
  prescriptionId   String?   @map("prescription_id") @db.Uuid
  saleId           String?   @map("sale_id") @db.Uuid
  patientName      String?   @map("patient_name") @db.VarChar(150)
  counselingDate   DateTime  @default(now()) @map("counseling_date") @db.Timestamp(6)
  educationSummary String    @map("education_summary") @db.Text
  note             String?   @db.Text
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamp(6)

  pharmacist   User          @relation("CounselingPharmacist", fields: [pharmacistId], references: [id])
  prescription Prescription? @relation(fields: [prescriptionId], references: [id])
  sale         Sale?         @relation(fields: [saleId], references: [id])

  @@index([pharmacistId], map: "idx_counseling_records_pharmacist_id")
  @@index([prescriptionId], map: "idx_counseling_records_prescription_id")
  @@index([saleId], map: "idx_counseling_records_sale_id")
  @@index([counselingDate], map: "idx_counseling_records_counseling_date")
  @@map("counseling_records")
}
